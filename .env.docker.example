# ==============================================================================
# Struyen Production & Local Docker Environment Variables
# Copy this file to .env before starting containers: `cp .env.docker.example .env`
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=struyen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432

# Redis Cache
REDIS_PORT=6379

# Backend Application Configuration
ADMIN_SECRET_KEY=your_admin_secret_key_here
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long_here
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# Google OAuth2 Authentication
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Frontend Next.js Configuration
# Leave empty string when behind Nginx reverse proxy (same-origin relative requests)
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Port Mapping for Host / VMware VM
HTTP_PORT=80

# Cloudflare Tunnel Configuration (Optional for Public HTTPS via VMware)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

